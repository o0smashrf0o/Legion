#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
bash "$ROOT/install-desktop-icon.sh" >/dev/null 2>&1 || true

PY="${PYTHON:-python3}"
[[ -x "$ROOT/.venv/bin/python" ]] && PY="$ROOT/.venv/bin/python"

"$PY" "$ROOT/gui/app.py" &
sleep 2

BROWSER="$(command -v chromium-browser || command -v chromium || command -v google-chrome || true)"
if [[ -z "$BROWSER" ]]; then
  echo "No Chromium found. Install with: sudo apt install -y chromium"
  exit 1
fi
exec "$BROWSER" --app=http://127.0.0.1:8088 --start-maximized --noerrdialogs --disable-infobars
