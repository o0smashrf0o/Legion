#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
if [[ -x "$ROOT/.venv/bin/python" ]]; then
  PY="$ROOT/.venv/bin/python"
else
  PY="${PYTHON:-python3}"
fi
# Start Flask in the background
"$PY" "$ROOT/gui/app.py" &
# Give the server a moment to start up
sleep 2
# Launch Chromium in kiosk mode pointing at the Legion HUD
chromium-browser --kiosk --noerrdialogs --disable-infobars http://192.168.50.2:8088
